# ==============================================================================
# QUẢN LÝ THI ĐUA GIÁO VIÊN - TH&THCS NGUYỄN ĐÌNH ANH
# PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# 1. SUPABASE DATABASE & AUTHENTICATION
# Lấy từ Supabase Dashboard: Project Settings -> API -> Project URL & Project API Keys
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# 2. SUPABASE STORAGE BUCKET
# Tên bucket lưu trữ hồ sơ minh chứng (đã cấu hình sẵn minh-chung-thi-dua)
VITE_SUPABASE_STORAGE_BUCKET="minh-chung-thi-dua"

# 3. AI & SERVER-SIDE INTEGRATION
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. APP DEPLOYMENT URL
# URL nơi ứng dụng được triển khai (ví dụ: Cloud Run URL, Vercel hoặc Custom Domain)
APP_URL="MY_APP_URL"

